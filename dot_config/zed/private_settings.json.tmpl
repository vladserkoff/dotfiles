// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "always_treat_brackets_as_autoclosed": true,
  "auto_install_extensions": {
    "docker-compose": true,
    "dockerfile": true,
    "fish": true,
    "html": true,
    "rainbow-csv": true,
    "sql": true,
    "toml": true
  },
  "auto_signature_help": true,
  "buffer_font_size": 16.0,
  "cli_default_open_behavior": "new_window",
  "close_on_file_delete": true,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.pixi",
    "**/.ropeproject",
    "**/.ruff_cache",
    "**/__pycache__",
    "**/.venv",
    "**/.ipynb_checkpoints",
    "**/*.egg-info",
    "**/*.pytest_cache",
    "**/.hypothesis",
    "**/.uv-cache"
  ],
  "format_on_save": "off",
  "languages": {
    "Make": {
      "show_edit_predictions": true
    },
    "Python": {
      // ty only — the default basedpyright is noisy on this setup.
      "language_servers": ["ty"],
      "show_edit_predictions": false
    }
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle"
  },
  // Panels: everything on the left except the agent.
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "copy_on_select": true
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "ui_font_size": 16
}
