{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# Reruns when .macos changes; see
# https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/#run-a-script-when-the-contents-of-another-file-changes
# .macos hash: {{ include ".macos" | sha256sum }}

printf '\n==> Applying macOS defaults\n'
bash {{ .chezmoi.sourceDir }}/.macos
printf '==> macOS defaults applied\n'
{{ end -}}
