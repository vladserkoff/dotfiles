#!/bin/bash
set -euo pipefail

# Make fish the login shell, on macOS and Linux alike.
fish_path="$(command -v fish || true)"
[ -n "$fish_path" ] || exit 0

[ "${SHELL:-}" = "$fish_path" ] && exit 0

if ! grep -qxF "$fish_path" /etc/shells; then
    echo "==> Registering $fish_path in /etc/shells"
    echo "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi

echo "==> Setting login shell to fish"
chsh -s "$fish_path"
